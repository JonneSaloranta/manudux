{
    "template": "## 📦 $TITLE ($TAG)\n\n### ✨ Changes\n$CHANGES\n",
    "change-template": "- $TITLE (#$NUMBER)",
    "label_extractor": [
        {
            "pattern": "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\\(.+\\))?(!)?:",
            "target": "$1",
            "on_property": "title"
        }
    ],
    "categories": [
        {
            "title": "🚀 Features",
            "labels": ["feature", "enhancement", "feat"]
        },
        {
            "title": "🐛 Bug Fixes",
            "labels": ["bug", "fix"]
        },
        {
            "title": "🧹 Other",
            "labels": ["chore", "docs", "ci", "build", "perf", "refactor", "revert", "style", "test"]
        }
    ]
}
